# This code controls the gas filter
alias filter db # Gas filter

main:
l r3 filter RatioPollutantInput # get the pollution value (change it to the desired gas)
l r10 filter RatioNitrousOxideInput # get the nitrous oxide value (change it to the desired gas)
sgtz r2 r3
sgtz r4 r10
or r1 r2 r4
s filter Mode r1
j main