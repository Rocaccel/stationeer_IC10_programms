alias gasSens d0
alias led d1
define vent -1129453144
define reg 554524804
define sens -1252983604

sbn vent HASH("VentCO2") On 0
sbn vent HASH("VentN2") On 0
sbn vent HASH("VentO2") On 0
sbn vent HASH("VentMaxPress") On 0

sbn vent HASH("VentCO2") Mode 0
sbn vent HASH("VentN2") Mode 0
sbn vent HASH("VentO2") Mode 0
sbn vent HASH("VentMaxPress") Mode 1

sbn vent HASH("VentCO2") Lock 1
sbn vent HASH("VentN2") Lock 1
sbn vent HASH("VentO2") Lock 1
sbn vent HASH("VentMaxPress") Lock 1

sbn reg HASH("RegCO2") Mode 100
sbn reg HASH("RegN2") Mode 100
sbn reg HASH("RegO2") Mode 101



main:
l r0 gasSens RatioCarbonDioxide
l r1 gasSens RatioNitrogen
l r2 gasSens RatioOxygen
lb r13 sens Pressure Average
s led Setting r13

#lbn r0 sens HASH("GasSensGH") RatioCarbonDioxide Sum
#lbn r1 sens HASH("GasSensGH") RatioNitrogen Sum
#lbn r2 sens HASH("GasSensGH") RatioOxygen Sum

lbn r4 reg HASH("RegCO2") Setting Sum
lbn r5 reg HASH("RegN2") Setting Sum
lbn r6 reg HASH("RegO2") Setting Sum

div r4 r4 100
div r5 r5 100

slt r10 r0 r4
slt r11 r1 r5
slt r14 r13 r6

sbn vent HASH("VentCO2") On r10
sbn vent HASH("VentN2") On r11
sbn vent HASH("VentO2") On r14

add r7 r13 -5
sgt r8 r7 r6
sbn vent HASH("VentMaxPress") On r8
j main
