#for CO2 ratio controler of GreenHouse for endless count of filters with name "FilterCO2"
alias gasSensor d0
define filtersCO2 -348054045

main:
l r0 gasSensor RatioCarbonDioxide
blt r0 0.05 turnON # to set desired ammount of % CO2
sbn filtersCO2  HASH("FilterCO2") On 0
j main

turnON:
sbn filtersCO2  HASH("FilterCO2") On 1
j main
